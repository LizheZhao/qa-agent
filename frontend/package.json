{
  "name": "orchestration-diagnostics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:api": "uv run --project .. python ../scripts/export_openapi.py .generated/openapi.json && openapi-typescript .generated/openapi.json -o src/api/schema.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/schema.d.ts",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
