LLM_SERVICE_URL=https://gateway.example.invalid
EXTERNAL_VENDOR=claude
EXTERNAL_MODEL=replace-with-model-name
CLIENT_CODE=replace-with-client-code
GATEWAY_TOKEN=replace-locally
GATEWAY_USER=replace-locally
GATEWAY_TIMEOUT_SECONDS=180

# Observability (optional; defaults shown)
OBSERVABILITY_FLUSH_TIMEOUT_SECONDS=2
OBSERVABILITY_MAX_PENDING_SNAPSHOTS=256

# Clarification pauses nobody came back to. The periodic pass is lifecycle cleanup, not a
# scheduler: set the interval to 0 to disable it, and request-time closure still frees a
# session the moment anyone uses it again. Expiry correctness never depends on either --
# a response arriving after the deadline is refused regardless.
PENDING_RUN_SWEEP_INTERVAL_SECONDS=60
PENDING_RUN_SWEEP_LIMIT=50

DEPLOYMENT_PATH=deployments/local.yaml
SOURCE_COMMIT=

# MongoDB
MONGODB_HOST=10.18.9.240
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PWD=
MONGODB_DB=

# Ask Genome BERT classifier service. Read directly from os.environ by
# nodes/question_understanding/classify_fields.py, same variable name ask-genome-core uses.
# Value below matches ask-genome-core/config/config.yaml -- the shared, ingress-routed service.
CLASSIFIER_SERVICE_URL=http://10.18.9.240/ask_genome_classifier

# Ask Genome agent (packages/agents/ask-genome) -- deliberately prefixed, not plain
# CLIENT_CODE/MODEL_GROUP_ID/DATA_DIR, to avoid colliding with this app's own CLIENT_CODE above
# (the enterprise LLM gateway's routing client -- a different concept). Read directly from
# os.environ, not this app's Settings, so these must be real exported environment variables --
# see ask_genome_agent/config.py's module docstring for why.
ASK_GENOME_CLIENT_CODE=replace-with-client-code
ASK_GENOME_MODEL_GROUP_ID=replace-with-model-group-id
ASK_GENOME_DATA_DIR=replace-with-data-dir-path
